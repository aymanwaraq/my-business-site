<style>
.flow-vertical{max-width:520px;margin:40px auto 0;display:flex;flex-direction:column;align-items:center}
.flow-node{background:#122a44;color:#e8eef7;padding:14px 28px;border-radius:8px;font-weight:600;font-size:15px;border:1px solid rgba(255,255,255,.08);width:100%;text-align:center}
.flow-down{color:#C9A84C;font-size:22px;font-weight:700;line-height:1;padding:10px 0}
.use-case{background:#122a44;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:28px}
.use-case h3{font-size:17px;font-weight:700;color:#fff;margin-bottom:16px}
.use-case-flow{font-size:13px;color:#c4d2e4;line-height:1.9;font-family:monospace;white-space:pre-wrap}
.use-case-flow .arrow{color:#C9A84C}
.pillars-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px}
.pillar{background:#122a44;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:24px}
.pillar .num{color:#C9A84C;font-size:12px;font-weight:800;letter-spacing:.1em;margin-bottom:8px}
.pillar h4{color:#fff;font-size:15px;font-weight:700;margin:0 0 10px}
.pillar p{color:#b8c5d6;font-size:13px;margin:0;line-height:1.6}
@media(max-width:900px){.pillars-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.pillars-grid{grid-template-columns:1fr}.use-case-flow{font-size:12px}}
</style>
