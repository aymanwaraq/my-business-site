<script>gtag('js',new Date());gtag('config','G-72BT0DL8NJ');</script>
<script>
(function(){
  try {
    var saved = localStorage.getItem('bts_theme');
    var pref = saved ? saved :
               (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (pref === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch(e){}
})();
</script>
<style>
/* ═══════════════════════════════════════════════════════════
   OMAN LOCATION PAGE
   ═══════════════════════════════════════════════════════════ */

:root {
  --bts-navy:#0b1a2b;
  --bts-navy-2:#122a44;
  --bts-navy-3:#1a3a5c;
  --bts-blue:#3b82f6;
  --bts-gold:#C9A84C;
  --bts-success:#10b981;
  --bts-warning:#f59e0b;
  --bts-danger:#ef4444;
  --bts-violet:#a78bfa;
}

/* ─── IMAGE HERO ──────────────────────────────────────── */
.bts-img-hero {
  position:relative;
  min-height:560px;
  background:
    linear-gradient(95deg, rgba(11,26,43,.92) 0%, rgba(11,26,43,.72) 30%, rgba(11,26,43,.20) 60%, rgba(11,26,43,.05) 100%),
    linear-gradient(160deg, #071322 0%, #0b1a2b 55%, #0e2136 100%);
  background-size:cover;
  background-position:center bottom;
  overflow:hidden;
  color:#fff;
  display:flex;
  align-items:center;
  padding:96px 0;
}
.bts-img-hero::before {
  content:"";
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size:64px 64px;
  mask-image: radial-gradient(circle at 80% 50%, #000 0%, transparent 65%);
  -webkit-mask-image: radial-gradient(circle at 80% 50%, #000 0%, transparent 65%);
  pointer-events:none;
  z-index:1;
}
.bts-img-hero .container { position:relative; z-index:2; }
.bts-img-hero-wrap {
  width:100%;
  max-width:1600px;
  margin:0;
  padding-left:6%;
  padding-right:6%;
  box-sizing:border-box;
}
.bts-img-hero-inner {
  max-width:480px;
  margin-left:0;
  margin-right:auto;
  text-align:left;
}
.bts-img-hero h1 {
  font-size:clamp(28px,3.6vw,48px);
  font-weight:800;
  line-height:1.1;
  letter-spacing:-.02em;
  margin:0 0 24px;
  color:#fff;
}
.bts-img-hero h1 em {
  font-style:normal;
  background:linear-gradient(120deg,#FFD770,#C9A84C 60%);
  -webkit-background-clip:text; background-clip:text;
  color:transparent;
}
.bts-img-hero-lead {
  font-size:16.5px;
  line-height:1.65;
  color:#c4d2e4;
  max-width:480px;
  margin:0 0 36px;
}
.bts-hero-cta { display:flex; gap:14px; flex-wrap:wrap; }
.bts-hero-eyebrow {
  display:inline-flex; align-items:center; gap:12px;
  font-size:12px; letter-spacing:.16em; text-transform:uppercase;
  color:#FFD770; font-weight:700;
  padding:8px 14px;
  border:1px solid rgba(255,215,112,.25);
  border-radius:100px;
  background:rgba(255,215,112,.06);
  margin-bottom:28px;
}
.bts-hero-eyebrow::before {
  content:""; width:6px; height:6px; border-radius:50%;
  background:#FFD770;
  box-shadow:0 0 0 3px rgba(255,215,112,.18);
}

/* ─── SECTION BASE ─────────────────────────────────────── */
.bts-section { padding:96px 0; position:relative; }
.bts-section.navy {
  background:
    radial-gradient(900px 400px at 15% -20%, rgba(59,130,246,.10), transparent 60%),
    linear-gradient(180deg,#0b1a2b 0%,#0a1729 100%);
  color:#e8eef7;
}
.bts-section.light {
  background:#f5f7fa;
  color:#1a2332;
}
[data-theme="dark"] .bts-section.light {
  background:#0e1f33;
  color:#e8eef7;
}

/* ─── SECTION HEADS ────────────────────────────────────── */
.bts-head { max-width:760px; margin-bottom:64px; }
.bts-head .rule {
  display:block; width:44px; height:2px;
  background:var(--bts-gold); margin-bottom:20px;
}
.bts-head .kicker {
  display:block;
  font-size:12.5px; letter-spacing:.16em; text-transform:uppercase;
  font-weight:700; color:var(--bts-gold); margin-bottom:14px;
}
.bts-head h2 {
  font-size:clamp(28px,3.4vw,46px);
  font-weight:800;
  line-height:1.1;
  letter-spacing:-.02em;
  margin:0 0 18px;
}
.bts-section.navy .bts-head h2 { color:#fff; }
.bts-section.light .bts-head h2 { color:#0b1a2b; }
[data-theme="dark"] .bts-section.light .bts-head h2 { color:#fff; }
.bts-head p {
  font-size:17px; line-height:1.65; margin:0;
  max-width:640px;
}
.bts-section.navy .bts-head p { color:#b8c5d6; }
.bts-section.light .bts-head p { color:#4a5666; }
[data-theme="dark"] .bts-section.light .bts-head p { color:#b8c5d6; }

/* ─── PILLARS ──────────────────────────────────────────── */
.bts-pillars {
  display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
}
.bts-pillar {
  background:#fff;
  border:1px solid #e6ebf2;
  border-radius:14px;
  padding:32px 26px;
  position:relative;
  transition:transform .25s, box-shadow .25s, border-color .25s;
}
.bts-pillar:hover {
  transform:translateY(-4px);
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-pillar {
  background:#122a44;
  border-color:rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-pillar:hover {
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(0,0,0,.3);
}
.bts-pillar .num {
  display:inline-block;
  font-size:11.5px; font-weight:800; letter-spacing:.12em;
  color:var(--bts-gold);
  padding:5px 10px;
  border-radius:100px;
  background:rgba(201,168,76,.08);
  border:1px solid rgba(201,168,76,.2);
  margin-bottom:20px;
}
[data-theme="dark"] .bts-pillar .num {
  background:rgba(201,168,76,.12);
  border-color:rgba(201,168,76,.25);
}
.bts-pillar h3 {
  font-size:18px; font-weight:700; margin:0 0 12px;
  color:#0b1a2b; line-height:1.25;
}
[data-theme="dark"] .bts-pillar h3 { color:#fff; }
.bts-pillar p {
  font-size:14.5px; line-height:1.65; color:#4a5666; margin:0;
}
[data-theme="dark"] .bts-pillar p { color:#b8c5d6; }

/* ─── SERVICE CARDS ────────────────────────────────────── */
.bts-services {
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
}
.bts-svc {
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  padding:32px 28px;
  transition:background .25s, border-color .25s, transform .25s;
  position:relative;
  overflow:hidden;
}
.bts-svc::after {
  content:"";
  position:absolute; left:0; top:0; bottom:0; width:2px;
  background:var(--bts-gold);
  transform:scaleY(0);
  transform-origin:top;
  transition:transform .35s ease;
}
.bts-svc:hover {
  background:rgba(59,130,246,.06);
  border-color:rgba(59,130,246,.28);
  transform:translateY(-3px);
}
.bts-svc:hover::after { transform:scaleY(1); }
.bts-svc h3 {
  font-size:17px; font-weight:700; color:#fff;
  margin:0 0 12px; letter-spacing:-.005em;
}
.bts-svc p {
  font-size:14.5px; line-height:1.65; color:#b8c5d6; margin:0;
}

/* ─── OMAN VISION OBJECTIVE MAP ───────────────────────── */
.bts-v2030 {
  display:grid;
  grid-template-columns: repeat(2, 1fr);
  gap:16px;
  margin-top:8px;
}
.bts-v2030-row {
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  border-radius:12px;
  padding:22px 24px;
  display:flex;
  gap:20px;
  align-items:flex-start;
  transition:background .25s, border-color .25s, transform .25s;
}
.bts-v2030-row:hover {
  background:rgba(59,130,246,.05);
  border-color:rgba(59,130,246,.28);
  transform:translateY(-2px);
}
.bts-v2030-key {
  flex:0 0 180px;
  font-size:14px;
  font-weight:800;
  color:#fff;
  letter-spacing:-.005em;
  line-height:1.4;
}
.bts-v2030-val {
  font-size:14px;
  line-height:1.6;
  color:#b8c5d6;
  margin:0;
}
.bts-v2030-note {
  margin-top:40px;
  padding-top:32px;
  border-top:1px solid rgba(255,255,255,.08);
  font-size:17px;
  line-height:1.7;
  color:#e8eef7;
  max-width:760px;
  font-weight:500;
}

/* ─── ENGAGEMENT PHASES ────────────────────────────────── */
.bts-phases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.bts-phase {
  background: #fff;
  border: 1px solid #e6ebf2;
  border-radius: 16px;
  padding: 40px 32px;
  position: relative;
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.bts-phase:hover {
  transform: translateY(-4px);
  border-color: #3b82f6;
  box-shadow: 0 24px 60px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-phase {
  background: #122a44;
  border-color: rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-phase:hover {
  border-color: rgba(59,130,246,.4);
  box-shadow: 0 24px 60px rgba(0,0,0,.35);
}
.bts-phase.featured {
  border-color: #3b82f6;
  box-shadow: 0 16px 48px rgba(59,130,246,.12);
}
[data-theme="dark"] .bts-phase.featured {
  border-color: rgba(59,130,246,.5);
  box-shadow: 0 16px 48px rgba(59,130,246,.18);
}
.bts-phase-num {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .16em;
  color: var(--bts-gold);
  margin-bottom: 16px;
}
.bts-phase h3 {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -.015em;
  color: #0b1a2b;
  margin: 0 0 16px;
}
[data-theme="dark"] .bts-phase h3 { color: #fff; }
.bts-phase-lead {
  font-size: 15px;
  line-height: 1.65;
  color: #4a5666;
  margin: 0 0 28px;
}
[data-theme="dark"] .bts-phase-lead { color: #b8c5d6; }
.bts-phase-meta {
  padding-top: 16px;
  border-top: 1px solid #e6ebf2;
  margin-bottom: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
[data-theme="dark"] .bts-phase-meta { border-color: rgba(255,255,255,.08); }
.bts-phase-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #7a8699;
}
[data-theme="dark"] .bts-phase-label { color: #7a8fa8; }
.bts-phase-value {
  font-size: 14.5px;
  font-weight: 600;
  color: #0b1a2b;
  line-height: 1.5;
}
[data-theme="dark"] .bts-phase-value { color: #e8eef7; }
.bts-phases-note {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid #e6ebf2;
  font-size: 17px;
  line-height: 1.6;
  color: #4a5666;
  text-align: center;
  max-width: 720px;
  margin-inline: auto;
  font-style: italic;
}
[data-theme="dark"] .bts-phases-note {
  border-color: rgba(255,255,255,.08);
  color: #b8c5d6;
}

/* ─── ACCESSIBILITY ───────────────────────────────────── */
.bts-hero-cta a:focus-visible,
.bts-hero-eyebrow:focus-visible,
.btn:focus-visible {
  outline: 2px solid #FFD770;
  outline-offset: 3px;
  border-radius: 4px;
}

/* ─── RESPONSIVE ───────────────────────────────────────── */
@media (max-width:1100px) {
  .bts-pillars { grid-template-columns:1fr 1fr; }
  .bts-services { grid-template-columns:1fr 1fr; }
  .bts-phases { grid-template-columns:1fr; }
  .bts-v2030 { grid-template-columns:1fr; }
}
@media (max-width:720px) {
  .bts-section { padding:64px 0; }
  .bts-pillars, .bts-services { grid-template-columns:1fr; }
  .bts-img-hero { padding:96px 0 64px; min-height:520px; }
  .bts-img-hero-inner { max-width:100%; }
  .bts-img-hero-lead { max-width:100%; }
  .bts-phase { padding: 32px 24px; }
  .bts-v2030-row { flex-direction:column; gap:8px; }
  .bts-v2030-key { flex:0 0 auto; }
}
</style>
</head>
<body>

