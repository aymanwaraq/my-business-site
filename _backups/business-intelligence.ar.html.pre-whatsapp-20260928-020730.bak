<!-- ═══════════════ 1. البطل ═══════════════ -->
<section class="bts-hero">
  <div class="container">
    <div class="bts-hero-grid">
      <div>
        <span class="bts-hero-eyebrow">تقنية بريطانية · تسليم في الخليج</span>
        <h1>ذكاء الأعمال <em>لعمليات المؤسسات</em>.</h1>
        <p class="bts-hero-lead">حوّل البيانات المتفرقة إلى لوحات تحكم واضحة ومؤشرات موثوقة وقرارات يمكن لفريقك تنفيذها — دون استبدال الأنظمة التي تشغّلها بالفعل.</p>
        <div class="bts-hero-cta">
          <a href="../ar.html#contact" class="btn btn-primary">ابدأ مشروعك</a>
          <a href="#how" class="btn btn-outline">كيف نعمل</a>
        </div>
        <div class="bts-hero-stats">
          <div class="hs"><strong>7</strong>أسواق الخليج</div>
          <div class="hs"><strong>عربي/إنجليزي</strong>ثنائي اللغة بالتصميم</div>
          <div class="hs"><strong>المملكة المتحدة</strong>التكنولوجيا والتنفيذ</div>
        </div>
      </div>

      <!-- لوحة معاينة ذكاء الأعمال -->
      <div class="bts-mock" aria-hidden="true">
        <div class="bts-mock-head">
          <div class="bts-mock-brand">
            <span class="dot"></span>
            BTS Analytics
          </div>
          <div class="bts-mock-sub">لوحة ذكاء الأعمال المباشرة</div>
        </div>
        <div class="bts-trend-stack">
          <!-- الإيرادات -->
          <div class="bts-trend blue">
            <div class="trend-label">الإيرادات (منذ بداية الشهر)</div>
            <div class="trend-value">
              £2.4M
              <span class="trend-delta">↑ 12% شهرياً</span>
            </div>
            <div class="trend-spark">
              <svg viewBox="0 0 88 38" preserveAspectRatio="none">
                <path class="spark-fill" d="M0,30 L10,26 L20,28 L30,22 L40,20 L50,14 L60,16 L70,10 L80,8 L88,6 L88,38 L0,38 Z"/>
