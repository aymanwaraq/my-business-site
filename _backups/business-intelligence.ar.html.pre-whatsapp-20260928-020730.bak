<!-- ═══════════════ 2. ما يميّز BTS ═══════════════ -->
<section class="bts-section light">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ما يميّز BTS</span>
      <h2>ذكاء الأعمال ليس لوحة تحكم. BTS يربط البيانات بالقرارات.</h2>
      <p>أربعة مكونات تعمل معاً لجعل ذكاء الأعمال موثوقاً في العمليات الحقيقية.</p>
    </div>

    <div class="bts-pillars">
      <div class="bts-pillar">
        <span class="num">01 · البيانات تتصل</span>
        <h3>من الأنظمة والجداول وواجهات API</h3>
        <p>نجمع البيانات من أنظمة ERP وCRM وأنظمة المستودعات ونقاط البيع والجداول وواجهات API الخارجية في طبقة موحّدة موثوقة.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">02 · المؤشرات تتوافق</span>
        <h3>تعريف واحد لكل مؤشر أداء</h3>
        <p>الإيرادات، الهامش، الاستخدام، التسليم في الوقت المحدد — تُعرّف مرة واحدة، ويوافق عليها العمل، وتُطبّق باستمرار.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">03 · الرؤى تظهر</span>
        <h3>لوحات وتنبيهات للأشخاص المناسبين</h3>
        <p>الإدارة ترى الاتجاه. العمليات ترى الاستثناء. الجميع يرى الأرقام نفسها.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">04 · الإجراء يتبع</span>
        <h3>قرارات تغيّر ما يحدث بعد ذلك</h3>
        <p>الرؤية لا تكون مفيدة إلا إذا أطلقت إجراءً — إعادة تعيين، تصعيد، إعادة طلب، مراجعة.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 3. ما نقدمه ═══════════════ -->
<section class="bts-section navy">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ما نقدمه</span>
      <h2>ذكاء أعمال عملي للأسئلة التي يطرحها عملك فعلياً.</h2>
      <p>ست قدرات تحوّل البيانات التشغيلية إلى قرارات يمكن لفرقك الاعتماد عليها.</p>
    </div>

    <div class="bts-services">
      <div class="bts-svc">
        <h3>لوحات المعلومات التنفيذية</h3>
        <p>عروض مباشرة وواضحة للمؤشرات التي تهم الإدارة — الإيرادات، الهامش، الاستخدام، خط الصفقات والأداء.</p>
      </div>
      <div class="bts-svc">
        <h3>تكامل البيانات</h3>
        <p>جمع المعلومات من أنظمة ERP وCRM وأنظمة المستودعات والجداول وقواعد البيانات وواجهات API الخارجية في مصدر واحد موثوق.</p>
      </div>
      <div class="bts-svc">
        <h3>التحليلات التشغيلية</h3>
        <p>تحديد الاتجاهات والعقبات ومشكلات الأداء عبر عمليات المستودعات واللوجستيات والمبيعات والخدمة.</p>
      </div>
      <div class="bts-svc">
        <h3>رؤى تنبؤية</h3>
        <p>استخدام البيانات التاريخية والتشغيلية لدعم التنبؤ وتخطيط الطلب والقرارات الاستباقية.</p>
      </div>
      <div class="bts-svc">
        <h3>جودة البيانات وحكومتها</h3>
        <p>تحديد الملكية وقواعد التحقق وجداول التحديث لتبقى الأرقام موثوقة مع الوقت.</p>
      </div>
      <div class="bts-svc">
        <h3>التقارير المُدمجة</h3>
        <p>دمج لوحات التحكم والتقارير مباشرة في الأنظمة التشغيلية التي يستخدمها فريقك يومياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 4. كيف نعمل ═══════════════ -->
<section class="bts-section light" id="how">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">كيف نعمل</span>
      <h2>من بيانات متفرقة إلى قرارات يثق بها فريقك.</h2>
      <p>نعمل على ثلاث مراحل. كل مرحلة تُسلّم شيئاً قابلاً للاستخدام قبل الانتقال إلى التالية.</p>
    </div>

    <div class="bts-phases">
      <div class="bts-phase">
        <div class="bts-phase-num">01</div>
        <h3>الاستكشاف</h3>
        <p class="bts-phase-lead">نحدد الأسئلة التي يحتاج عملك إجابات عليها فعلاً، ونراجع مصادر البيانات وراءها، ونرسم ما هو مفقود أو مكرر أو غير موثوق.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">أسبوعان</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">تعريف المؤشرات، مراجعة مصادر البيانات، مواصفات لوحة التحكم</span>
        </div>
      </div>

      <div class="bts-phase featured">
        <div class="bts-phase-num">02</div>
        <h3>النمذجة</h3>
        <p class="bts-phase-lead">نبني طبقة البيانات وأول لوحات التحكم. كل مؤشر يُعرّف مرة واحدة، ويُستمد من النظام الصحيح، ويُتحقق منه مقابل الأرقام التي يثق بها فريقا المالية والعمليات.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">4–8 أسابيع</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">لوحات تحكم فعّالة، خط بيانات، تعريفات موثّقة للمؤشرات</span>
        </div>
      </div>

      <div class="bts-phase">
        <div class="bts-phase-num">03</div>
        <h3>النشر</h3>
        <p class="bts-phase-lead">ننشر الحل للفرق التي تحتاجه، وندمج التقارير في الأنظمة التي تستخدمها، ونضع دورات التحديث والملكية والتنبيهات لتبقى الأرقام موثوقة مع الوقت.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">مستمر</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">نشر للفرق، تقارير مُدمجة، ملكية البيانات وجدول التحديث</span>
        </div>
      </div>
    </div>

    <p class="bts-phases-note">ذكاء الأعمال الجيد ليس رسوماً بيانية أكثر. إنه الأرقام نفسها، يثق بها الجميع، وتُستخدم لاتخاذ قرارات أفضل.</p>
  </div>
</section>

<!-- ═══════════════ 5. ميزة بريطانيا والخليج ═══════════════ -->
<section class="bts-section navy">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ميزة بريطانيا والخليج</span>
      <h2>مُصمّمة للطريقة التي تعمل بها الشركات في بريطانيا ودول الخليج فعلياً.</h2>
      <p>تخصصنا هو تقاطع ثلاثة عناصر يتعامل معظم مزوّدي ذكاء الأعمال مع واحد منها فقط.</p>
    </div>

    <div class="bts-services">
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">تقنية بريطانية</span>
        <h3>تحليلات مبنية وفق معايير بريطانية</h3>
        <p>الأمان وحكومة البيانات والهندسة مُصمّمة وفق المعايير البريطانية — نظيفة وموثّقة وقابلة للصيانة من أي فريق.</p>
      </div>
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">عربي + إنجليزي</span>
        <h3>لوحات ثنائية اللغة، لا مترجمة</h3>
        <p>واجهات RTL وتسميات عربية وتعريفات مؤشرات باللغتين — مُصمّمة من البداية، لا مُضافة لاحقاً.</p>
      </div>
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">عمليات الخليج</span>
        <h3>مؤشرات للعمليات الإقليمية</h3>
        <p>اللوجستيات، الجمارك، استخدام المستودعات، عمليات واتساب — المؤشرات التي تهم في أسواق الخليج.</p>
      </div>
    </div>
  </div>
</section>

