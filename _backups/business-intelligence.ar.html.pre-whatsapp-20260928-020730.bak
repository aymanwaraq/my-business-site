<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ذكاء الأعمال لمؤسسات المملكة المتحدة والخليج | BTS</title>
<meta name="description" content="تبني BTS حلول ذكاء الأعمال ولوحات التحكم وخطوط البيانات التي تحوّل بيانات الأعمال إلى رؤى واضحة قابلة للتنفيذ للمؤسسات في المملكة المتحدة ودول الخليج.">
<link rel="canonical" href="https://btsapp.net/services/business-intelligence.ar.html">
<link rel="alternate" hreflang="en" href="https://btsapp.net/services/business-intelligence.html">
<link rel="alternate" hreflang="ar" href="https://btsapp.net/services/business-intelligence.ar.html">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/style.css">
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{analytics_storage:'denied'});</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-72BT0DL8NJ"></script>
<script>gtag('js',new Date());gtag('config','G-72BT0DL8NJ');</script>
<script>
(function(){
  try {
    var saved = localStorage.getItem('bts_theme');
    var pref = saved ? saved :
               (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (pref === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch(e){}
})();
</script>
<style>
/* ═══════════════════════════════════════════════════════════
   صفحة ذكاء الأعمال — النسخة العربية
   نفس بنية صفحة أتمتة الذكاء الاصطناعي مع تعديلات RTL
   ═══════════════════════════════════════════════════════════ */

:root {
  --bts-navy:#0b1a2b;
  --bts-navy-2:#122a44;
  --bts-navy-3:#1a3a5c;
  --bts-blue:#3b82f6;
  --bts-gold:#C9A84C;
  --bts-success:#10b981;
  --bts-warning:#f59e0b;
  --bts-danger:#ef4444;
  --bts-violet:#a78bfa;
}

/* ─── HERO ─────────────────────────────────────────────── */
.bts-hero {
  background:
    radial-gradient(1200px 600px at 15% -10%, rgba(59,130,246,.18), transparent 60%),
    radial-gradient(900px 500px at 90% 100%, rgba(201,168,76,.10), transparent 55%),
    linear-gradient(200deg, #071322 0%, #0b1a2b 55%, #0e2136 100%);
  color:#fff;
  padding:96px 0 88px;
  position:relative;
  overflow:hidden;
}
.bts-hero::before {
  content:"";
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:64px 64px;
  mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
  -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
  pointer-events:none;
}
.bts-hero .container { position:relative; z-index:2; }
.bts-hero-grid {
  display:grid;
  grid-template-columns: 1.1fr 1fr;
  gap:72px;
  align-items:center;
}
.bts-hero-eyebrow {
  display:inline-flex; align-items:center; gap:12px;
  font-size:12.5px; letter-spacing:.06em;
  color:#FFD770; font-weight:700;
  padding:8px 14px;
  border:1px solid rgba(255,215,112,.25);
  border-radius:100px;
  background:rgba(255,215,112,.06);
  margin-bottom:28px;
}
.bts-hero-eyebrow::before {
  content:""; width:6px; height:6px; border-radius:50%;
  background:#FFD770;
  box-shadow:0 0 0 3px rgba(255,215,112,.18);
}
.bts-hero h1 {
  font-size:clamp(32px,3.8vw,54px);
  font-weight:800;
  line-height:1.25;
  margin:0 0 24px;
  color:#fff;
}
.bts-hero h1 em {
  font-style:normal;
  background:linear-gradient(120deg,#FFD770,#C9A84C 60%);
  -webkit-background-clip:text; background-clip:text;
  color:transparent;
}
.bts-hero-lead {
  font-size:17.5px;
  line-height:1.8;
  color:#c4d2e4;
  max-width:560px;
  margin:0 0 36px;
}
.bts-hero-cta { display:flex; gap:14px; flex-wrap:wrap; }
.bts-hero-stats {
  display:flex; gap:32px; margin-top:48px;
  padding-top:32px;
  border-top:1px solid rgba(255,255,255,.08);
}
.bts-hero-stats .hs { font-size:13px; color:#7a8fa8; }
.bts-hero-stats .hs strong {
  display:block; color:#fff; font-size:22px; font-weight:800;
  margin-bottom:4px;
  direction:ltr;
  unicode-bidi:isolate;
  text-align:right;
}

/* ─── BI TREND MOCKUP ──────────────────────────────────── */
.bts-mock {
  background:linear-gradient(160deg,#0d1f34 0%,#0a1828 100%);
  border:1px solid rgba(255,255,255,.08);
  border-radius:16px;
  padding:28px;
  box-shadow:
    0 30px 80px rgba(0,0,0,.5),
    0 0 0 1px rgba(59,130,246,.08) inset;
  position:relative;
  direction:rtl;
}
.bts-mock::before {
  content:"";
  position:absolute; inset:-1px;
  border-radius:16px;
  background:linear-gradient(135deg,rgba(59,130,246,.35),transparent 40%,transparent 60%,rgba(201,168,76,.25));
  z-index:-1;
  filter:blur(12px);
  opacity:.6;
}
.bts-mock-head {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:22px;
  flex-direction:row-reverse;
}
.bts-mock-brand {
  display:flex; align-items:center; gap:10px;
  font-size:14px; font-weight:700; color:#fff;
  font-family:'Inter',sans-serif;
  direction:ltr;
}
.bts-mock-brand .dot {
  width:8px; height:8px; border-radius:50%;
  background:#10b981;
  box-shadow:0 0 0 3px rgba(16,185,129,.2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { box-shadow:0 0 0 3px rgba(16,185,129,.2); }
  50%     { box-shadow:0 0 0 6px rgba(16,185,129,.05); }
}
.bts-mock-sub {
  font-size:11.5px; color:#7a8fa8;
  letter-spacing:.02em;
}

/* Trend strip */
.bts-trend-stack {
  display:flex;
  flex-direction:column;
  gap:10px;
}
.bts-trend {
  background:#0a1729;
  border:1px solid rgba(255,255,255,.06);
  border-radius:10px;
  padding:14px 16px 12px;
  display:grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: auto auto;
  gap:8px 14px;
  align-items:center;
  position:relative;
  overflow:hidden;
}
.bts-trend::before {
  content:""; position:absolute; top:0; right:0; left:0; height:2px;
  background:var(--trend-accent, #3b82f6);
  opacity:.9;
}
.bts-trend .trend-label {
  grid-column:1; grid-row:1;
  font-size:11px;
  color:#7a8fa8; font-weight:600;
}
.bts-trend .trend-value {
  grid-column:1; grid-row:2;
  font-size:22px; font-weight:800; line-height:1;
  color:#fff;
  display:flex;
  align-items:baseline;
  gap:8px;
  direction:ltr;
  unicode-bidi:isolate;
  justify-content:flex-end;
}
.bts-trend .trend-delta {
  font-size:11.5px;
  font-weight:700;
  color:var(--trend-accent, #3b82f6);
}
.bts-trend .trend-spark {
  grid-column:2; grid-row:1 / span 2;
  width:88px; height:38px;
  display:block;
  direction:ltr;
}
.bts-trend .trend-spark svg {
  width:100%; height:100%;
  display:block;
  overflow:visible;
}
.bts-trend .trend-spark path.spark-line {
  fill:none;
  stroke:var(--trend-accent, #3b82f6);
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.bts-trend .trend-spark path.spark-fill {
  fill:var(--trend-accent, #3b82f6);
  opacity:.12;
  stroke:none;
}

.bts-trend.blue   { --trend-accent:#3b82f6; }
.bts-trend.green  { --trend-accent:#10b981; }
.bts-trend.gold   { --trend-accent:#C9A84C; }
.bts-trend.violet { --trend-accent:#a78bfa; }

/* ─── SECTION BASE ─────────────────────────────────────── */
.bts-section { padding:96px 0; position:relative; }
.bts-section.navy {
  background:
    radial-gradient(900px 400px at 85% -20%, rgba(59,130,246,.10), transparent 60%),
    linear-gradient(180deg,#0b1a2b 0%,#0a1729 100%);
  color:#e8eef7;
}
.bts-section.light {
  background:#f5f7fa;
  color:#1a2332;
}
[data-theme="dark"] .bts-section.light {
  background:#0e1f33;
  color:#e8eef7;
}

/* ─── SECTION HEADS ────────────────────────────────────── */
.bts-head { max-width:760px; margin-bottom:64px; }
.bts-head .rule {
  display:block; width:44px; height:2px;
  background:var(--bts-gold); margin-bottom:20px;
}
.bts-head .kicker {
  display:block;
  font-size:13px; letter-spacing:.04em;
  font-weight:700; color:var(--bts-gold); margin-bottom:14px;
}
.bts-head h2 {
  font-size:clamp(26px,3.2vw,42px);
  font-weight:800;
  line-height:1.35;
  margin:0 0 18px;
}
.bts-section.navy .bts-head h2 { color:#fff; }
.bts-section.light .bts-head h2 { color:#0b1a2b; }
[data-theme="dark"] .bts-section.light .bts-head h2 { color:#fff; }
.bts-head p {
  font-size:16.5px; line-height:1.85; margin:0;
  max-width:640px;
}
.bts-section.navy .bts-head p { color:#b8c5d6; }
.bts-section.light .bts-head p { color:#4a5666; }
[data-theme="dark"] .bts-section.light .bts-head p { color:#b8c5d6; }

/* ─── PILLARS ──────────────────────────────────────────── */
.bts-pillars {
  display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
}
.bts-pillar {
  background:#fff;
  border:1px solid #e6ebf2;
  border-radius:14px;
  padding:32px 26px;
  position:relative;
  transition:transform .25s, box-shadow .25s, border-color .25s;
}
.bts-pillar:hover {
  transform:translateY(-4px);
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-pillar {
  background:#122a44;
  border-color:rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-pillar:hover {
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(0,0,0,.3);
}
.bts-pillar .num {
  display:inline-block;
  font-size:11.5px; font-weight:800;
  color:var(--bts-gold);
  padding:5px 10px;
  border-radius:100px;
  background:rgba(201,168,76,.08);
  border:1px solid rgba(201,168,76,.2);
  margin-bottom:20px;
}
[data-theme="dark"] .bts-pillar .num {
  background:rgba(201,168,76,.12);
  border-color:rgba(201,168,76,.25);
}
.bts-pillar h3 {
  font-size:17px; font-weight:700; margin:0 0 12px;
  color:#0b1a2b; line-height:1.5;
}
[data-theme="dark"] .bts-pillar h3 { color:#fff; }
.bts-pillar p {
  font-size:14.5px; line-height:1.8; color:#4a5666; margin:0;
}
[data-theme="dark"] .bts-pillar p { color:#b8c5d6; }

/* ─── SERVICE CARDS ────────────────────────────────────── */
.bts-services {
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
}
.bts-svc {
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  padding:32px 28px;
  transition:background .25s, border-color .25s, transform .25s;
  position:relative;
  overflow:hidden;
}
.bts-svc::after {
  content:"";
  position:absolute; right:0; top:0; bottom:0; width:2px;
  background:var(--bts-gold);
  transform:scaleY(0);
  transform-origin:top;
  transition:transform .35s ease;
}
.bts-svc:hover {
  background:rgba(59,130,246,.06);
  border-color:rgba(59,130,246,.28);
  transform:translateY(-3px);
}
.bts-svc:hover::after { transform:scaleY(1); }
.bts-svc h3 {
  font-size:17px; font-weight:700; color:#fff;
  margin:0 0 12px;
}
.bts-svc p {
  font-size:14.5px; line-height:1.8; color:#b8c5d6; margin:0;
}

/* ─── ENGAGEMENT PHASES ────────────────────────────────── */
.bts-phases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.bts-phase {
  background: #fff;
  border: 1px solid #e6ebf2;
  border-radius: 16px;
  padding: 40px 32px;
  position: relative;
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.bts-phase:hover {
  transform: translateY(-4px);
  border-color: #3b82f6;
  box-shadow: 0 24px 60px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-phase {
  background: #122a44;
  border-color: rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-phase:hover {
  border-color: rgba(59,130,246,.4);
  box-shadow: 0 24px 60px rgba(0,0,0,.35);
}
.bts-phase.featured {
  border-color: #3b82f6;
  box-shadow: 0 16px 48px rgba(59,130,246,.12);
}
[data-theme="dark"] .bts-phase.featured {
  border-color: rgba(59,130,246,.5);
  box-shadow: 0 16px 48px rgba(59,130,246,.18);
}
.bts-phase-num {
  font-size: 12px;
  font-weight: 800;
  color: var(--bts-gold);
  margin-bottom: 16px;
}
.bts-phase h3 {
  font-size: 24px;
  font-weight: 800;
  color: #0b1a2b;
  margin: 0 0 16px;
}
[data-theme="dark"] .bts-phase h3 { color: #fff; }
.bts-phase-lead {
  font-size: 15px;
  line-height: 1.8;
  color: #4a5666;
  margin: 0 0 28px;
}
[data-theme="dark"] .bts-phase-lead { color: #b8c5d6; }
.bts-phase-meta {
  padding-top: 16px;
  border-top: 1px solid #e6ebf2;
  margin-bottom: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
[data-theme="dark"] .bts-phase-meta { border-color: rgba(255,255,255,.08); }
.bts-phase-label {
  font-size: 11.5px;
  font-weight: 800;
  color: #7a8699;
}
[data-theme="dark"] .bts-phase-label { color: #7a8fa8; }
.bts-phase-value {
  font-size: 14.5px;
  font-weight: 600;
  color: #0b1a2b;
  line-height: 1.6;
}
[data-theme="dark"] .bts-phase-value { color: #e8eef7; }
.bts-phases-note {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid #e6ebf2;
  font-size: 17px;
  line-height: 1.8;
  color: #4a5666;
  text-align: center;
  max-width: 720px;
  margin-inline: auto;
  font-style: italic;
}
[data-theme="dark"] .bts-phases-note {
  border-color: rgba(255,255,255,.08);
  color: #b8c5d6;
}

/* ─── PRODUCT TAG ─────────────────────────────────────── */
.bts-product-tag {
  display:inline-block;
  font-size:11px; font-weight:800;
  padding:5px 10px; border-radius:100px;
  margin-bottom:20px;
}
.bts-product-tag.dev {
  color:#FFD770;
  background:rgba(201,168,76,.1);
  border:1px solid rgba(201,168,76,.25);
}

/* ─── ACCESSIBILITY ───────────────────────────────────── */
.bts-hero-cta a:focus-visible,
.bts-hero-eyebrow:focus-visible,
.btn:focus-visible {
  outline: 2px solid #FFD770;
  outline-offset: 3px;
  border-radius: 4px;
}

/* ─── RTL refinements ─────────────────────────────────── */
body.rtl .bts-head .rule { margin-inline-start: 0; }
body.rtl .bts-hero-stats { flex-direction:row-reverse; }

/* ─── RESPONSIVE ───────────────────────────────────────── */
@media (max-width:1100px) {
  .bts-hero-grid { grid-template-columns:1fr; gap:48px; }
  .bts-pillars { grid-template-columns:1fr 1fr; }
  .bts-services { grid-template-columns:1fr 1fr; }
  .bts-phases { grid-template-columns:1fr; }
}
@media (max-width:720px) {
  .bts-section { padding:64px 0; }
  .bts-pillars, .bts-services { grid-template-columns:1fr; }
  .bts-hero { padding:64px 0 56px; }
  .bts-hero-stats { gap:22px; flex-wrap:wrap; }
  .bts-mock { padding:20px; }
  .bts-trend { grid-template-columns: 1fr auto; padding:12px 14px 10px; }
  .bts-trend .trend-spark { width:64px; height:32px; }
  .bts-phase { padding: 32px 24px; }
}
</style>
</head>
<body class="rtl">

<div class="utility-bar"><div class="container">
  <div><a href="../ar.html">BTS · غلاسكو، المملكة المتحدة</a></div>
  <div>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="تبديل الوضع الداكن" title="تبديل الوضع الداكن">
      <svg class="icon-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    </button>
    <a href="../blog/">رؤى</a>
    <a href="../ar.html#contact">اتصل بنا</a>
    <a href="business-intelligence.html" onclick="setLang('en')">English</a>
  </div>
</div></div>

<nav class="nav"><div class="container">
  <a href="../ar.html" class="brand">
    <img src="../assets/images/Logo.png" alt="BTS">
    حلول تكنولوجيا الأعمال
  </a>
