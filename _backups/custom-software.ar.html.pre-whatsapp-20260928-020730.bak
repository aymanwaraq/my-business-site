<!-- ═══════════════ 2. ما يميّز BTS ═══════════════ -->
<section class="bts-section light">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ما يميّز BTS</span>
      <h2>برمجيات مبنية لعملياتك، لا معدّلة لتلائمها.</h2>
      <p>أربعة مبادئ تُشكّل كل تطبيق نبنيه.</p>
    </div>

    <div class="bts-pillars">
      <div class="bts-pillar">
        <span class="num">01 · سير عملك</span>
        <h3>مصمّمة وفق الطريقة التي تعمل بها فعلاً</h3>
        <p>لا نفرض عليك قالباً جاهزاً. التطبيق يلائم عمليتك، لا العكس.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">02 · بياناتك</span>
        <h3>متصلة بالأنظمة التي تشغّلها بالفعل</h3>
        <p>ERP وCRM وأنظمة المستودعات وقواعد البيانات وواجهات API — برنامجك الجديد يتصل بما هو موجود، لا يستبدله.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">03 · فريقك</span>
        <h3>مبنية للأشخاص الذين سيستخدمونها يومياً</h3>
        <p>واجهات واضحة، وإعدادات افتراضية منطقية، وبلا تعقيد غير ضروري. التبنّي جزء من التصميم.</p>
      </div>
      <div class="bts-pillar">
        <span class="num">04 · مستقبلك</span>
        <h3>موثّقة وقابلة للصيانة وجاهزة للتطور</h3>
        <p>كود نظيف وتوثيق حقيقي، بلا احتكار. يستطيع فريقك — أو فريقنا — توسيعها بأمان لسنوات.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 3. ما نبنيه ═══════════════ -->
<section class="bts-section navy">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ما نبنيه</span>
      <h2>برمجيات عملية لاحتياجات المؤسسات الحقيقية.</h2>
      <p>ست فئات من التطبيقات نصمّمها ونسلّمها لمؤسسات في بريطانيا ودول الخليج.</p>
    </div>

    <div class="bts-services">
      <div class="bts-svc">
        <h3>تطبيقات الأعمال</h3>
        <p>تطبيقات ويب وبوابات وأنظمة داخلية لإدارة العمليات اليومية.</p>
      </div>
      <div class="bts-svc">
        <h3>منصات تشغيلية</h3>
        <p>أنظمة للوجستيات والمستودعات وسير العمل والموافقات والتقارير والعمليات الأساسية.</p>
      </div>
      <div class="bts-svc">
        <h3>بوابات العملاء</h3>
        <p>بوابات موجهة للعملاء للطلبات والطلبات الخاصة والتتبع والمستندات والخدمة الذاتية.</p>
      </div>
      <div class="bts-svc">
        <h3>أنظمة الإدارة والمكاتب الخلفية</h3>
        <p>أدوات داخلية ولوحات تحكم ولوحات إدارة تحلّ محل جداول البيانات والعمل اليدوي.</p>
      </div>
      <div class="bts-svc">
        <h3>أنظمة عربية وإنجليزية</h3>
        <p>واجهات ثنائية اللغة مع دعم كامل للاتجاه من اليمين لليسار، مبنية للفرق والعملاء باللغتين.</p>
      </div>
      <div class="bts-svc">
        <h3>تحديث الأنظمة القديمة</h3>
        <p>استبدال الأدوات القديمة وجداول البيانات بأنظمة حديثة قابلة للصيانة — دون تعطيل العمليات.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 4. كيف نعمل ═══════════════ -->
<section class="bts-section light" id="how">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">كيف نعمل</span>
      <h2>من المحادثة الأولى إلى برنامج فعّال.</h2>
      <p>ثلاث مراحل. كل مرحلة تُسلّم شيئاً قابلاً للاستخدام قبل الانتقال إلى التالية.</p>
    </div>

    <div class="bts-phases">
      <div class="bts-phase">
        <div class="bts-phase-num">01</div>
        <h3>الاستكشاف</h3>
        <p class="bts-phase-lead">نرسم خريطة سير العمل، ونتفق على النطاق، ونصمّم نموذج البيانات وراء التطبيق. ترى نموذجاً أولياً قبل بدء التطوير.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">أسبوعان</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">متطلبات محدّدة، نموذج بيانات، نموذج أولي قابل للنقر</span>
        </div>
      </div>

      <div class="bts-phase featured">
        <div class="bts-phase-num">02</div>
        <h3>البناء</h3>
        <p class="bts-phase-lead">نطوّر التطبيق على دورات قصيرة. تراه يعمل طوال الوقت — لا في النهاية — وكل ميزة تُختبر مقابل بيانات حقيقية قبل التسليم.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">6–10 أسابيع</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">تطبيق فعّال، تكامل مع أنظمتك، مُختبر ببيانات حقيقية</span>
        </div>
      </div>

      <div class="bts-phase">
        <div class="bts-phase-num">03</div>
        <h3>التسليم</h3>
        <p class="bts-phase-lead">ننشر النظام، وندرّب فريقك، ونوثّق البرنامج، ونبقى متاحين للتطوير. البرنامج يصبح ملكك — بلا احتكار، وبلا ارتباط بمزوّد واحد.</p>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">المدة النموذجية</span>
          <span class="bts-phase-value">مستمر</span>
        </div>
        <div class="bts-phase-meta">
          <span class="bts-phase-label">ما تحصل عليه</span>
          <span class="bts-phase-value">النشر، تدريب الفريق، التوثيق، دعم التطوير</span>
        </div>
      </div>
    </div>

    <p class="bts-phases-note">أفضل برنامج ليس الأكثر تقدماً. إنه الذي يستخدمه فريقك فعلاً كل يوم.</p>
  </div>
</section>

<!-- ═══════════════ 5. ميزة بريطانيا والخليج ═══════════════ -->
<section class="bts-section navy">
  <div class="container">
    <div class="bts-head">
      <span class="rule"></span>
      <span class="kicker">ميزة بريطانيا والخليج</span>
      <h2>مُصمّمة للطريقة التي تعمل بها الشركات في بريطانيا ودول الخليج فعلياً.</h2>
      <p>تخصصنا هو تقاطع ثلاثة عناصر يتعامل معظم مزوّدي البرمجيات مع واحد منها فقط.</p>
    </div>

    <div class="bts-services">
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">تقنية بريطانية</span>
        <h3>برمجيات مبنية وفق معايير بريطانية</h3>
        <p>الأمان والهندسة وجودة الكود مُصمّمة وفق المعايير البريطانية — نظيفة وموثّقة وقابلة للصيانة من أي فريق.</p>
      </div>
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">عربي + إنجليزي</span>
        <h3>ثنائية اللغة من السطر الأول من الكود</h3>
        <p>واجهات عربية وإنجليزية مُصمّمة من البداية — لا مترجمة لاحقاً، ولا مُضافة كفكرة ثانوية.</p>
      </div>
      <div class="bts-svc">
        <span class="bts-product-tag dev" style="margin-bottom:16px">عمليات الخليج</span>
        <h3>مبنية لواقع الأعمال الإقليمي</h3>
        <p>سير عمل اللوجستيات، المستندات الجمركية، عمليات واتساب، هيكليات متعددة العملات والفروع.</p>
      </div>
    </div>
  </div>
</section>

