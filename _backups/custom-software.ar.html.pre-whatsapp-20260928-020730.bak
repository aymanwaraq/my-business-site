<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>برمجيات مخصصة لمؤسسات المملكة المتحدة والخليج | BTS</title>
<meta name="description" content="تبني BTS برمجيات مخصصة — تطبيقات ويب ومنصات تشغيلية وبوابات عملاء وأنظمة داخلية — لمؤسسات في المملكة المتحدة ودول الخليج.">
<link rel="canonical" href="https://btsapp.net/services/custom-software.ar.html">
<link rel="alternate" hreflang="en" href="https://btsapp.net/services/custom-software.html">
<link rel="alternate" hreflang="ar" href="https://btsapp.net/services/custom-software.ar.html">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/style.css">
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{analytics_storage:'denied'});</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-72BT0DL8NJ"></script>
<script>gtag('js',new Date());gtag('config','G-72BT0DL8NJ');</script>
<script>
(function(){
  try {
    var saved = localStorage.getItem('bts_theme');
    var pref = saved ? saved :
               (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (pref === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch(e){}
})();
</script>
<style>
/* ═══════════════════════════════════════════════════════════
   صفحة البرمجيات المخصصة — النسخة العربية
   ═══════════════════════════════════════════════════════════ */

:root {
  --bts-navy:#0b1a2b;
  --bts-navy-2:#122a44;
  --bts-navy-3:#1a3a5c;
  --bts-blue:#3b82f6;
  --bts-gold:#C9A84C;
  --bts-success:#10b981;
  --bts-warning:#f59e0b;
  --bts-danger:#ef4444;
  --bts-violet:#a78bfa;
}

/* ─── HERO ─────────────────────────────────────────────── */
.bts-hero {
  background:
    radial-gradient(1200px 600px at 15% -10%, rgba(59,130,246,.18), transparent 60%),
    radial-gradient(900px 500px at 90% 100%, rgba(201,168,76,.10), transparent 55%),
    linear-gradient(200deg, #071322 0%, #0b1a2b 55%, #0e2136 100%);
  color:#fff;
  padding:96px 0 88px;
  position:relative;
  overflow:hidden;
}
.bts-hero::before {
  content:"";
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:64px 64px;
  mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
  -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
  pointer-events:none;
}
.bts-hero .container { position:relative; z-index:2; }
.bts-hero-grid {
  display:grid;
  grid-template-columns: 1fr 1.15fr;
  gap:64px;
  align-items:center;
}
.bts-hero-eyebrow {
  display:inline-flex; align-items:center; gap:12px;
  font-size:12.5px; letter-spacing:.06em;
  color:#FFD770; font-weight:700;
  padding:8px 14px;
  border:1px solid rgba(255,215,112,.25);
  border-radius:100px;
  background:rgba(255,215,112,.06);
  margin-bottom:28px;
}
.bts-hero-eyebrow::before {
  content:""; width:6px; height:6px; border-radius:50%;
  background:#FFD770;
  box-shadow:0 0 0 3px rgba(255,215,112,.18);
}
.bts-hero h1 {
  font-size:clamp(32px,3.8vw,54px);
  font-weight:800;
  line-height:1.25;
  margin:0 0 24px;
  color:#fff;
}
.bts-hero h1 em {
  font-style:normal;
  background:linear-gradient(120deg,#FFD770,#C9A84C 60%);
  -webkit-background-clip:text; background-clip:text;
  color:transparent;
}
.bts-hero-lead {
  font-size:17.5px;
  line-height:1.8;
  color:#c4d2e4;
  max-width:520px;
  margin:0 0 36px;
}
.bts-hero-cta { display:flex; gap:14px; flex-wrap:wrap; }
.bts-hero-stats {
  display:flex; gap:32px; margin-top:48px;
  padding-top:32px;
  border-top:1px solid rgba(255,255,255,.08);
}
.bts-hero-stats .hs { font-size:13px; color:#7a8fa8; }
.bts-hero-stats .hs strong {
  display:block; color:#fff; font-size:22px; font-weight:800;
  margin-bottom:4px;
  direction:ltr;
  unicode-bidi:isolate;
  text-align:right;
}

/* ─── APP MOCKUP ───────────────────────────────────────── */
.bts-mock {
  background:linear-gradient(160deg,#0d1f34 0%,#0a1828 100%);
  border:1px solid rgba(255,255,255,.08);
  border-radius:16px;
  padding:0;
  overflow:hidden;
  box-shadow:
    0 30px 80px rgba(0,0,0,.5),
    0 0 0 1px rgba(59,130,246,.08) inset;
  position:relative;
  direction:rtl;
}
.bts-mock::before {
  content:"";
  position:absolute; inset:-1px;
  border-radius:16px;
  background:linear-gradient(135deg,rgba(59,130,246,.35),transparent 40%,transparent 60%,rgba(201,168,76,.25));
  z-index:-1;
  filter:blur(12px);
  opacity:.6;
}

.bts-app-chrome {
  background:#08131f;
  border-bottom:1px solid rgba(255,255,255,.06);
  padding:12px 16px;
  display:flex;
  align-items:center;
  gap:14px;
}
.bts-app-dots {
  display:flex;
  gap:6px;
}
.bts-app-dots span {
  width:10px; height:10px; border-radius:50%;
  background:#2a3a4e;
}
.bts-app-dots span:nth-child(1){ background:#ef4444; opacity:.7; }
.bts-app-dots span:nth-child(2){ background:#f59e0b; opacity:.7; }
.bts-app-dots span:nth-child(3){ background:#10b981; opacity:.7; }
.bts-app-url {
  flex:1;
  background:#0a1729;
  border-radius:6px;
  padding:6px 12px;
  font-size:11.5px;
  color:#7a8fa8;
  font-family:'Inter',monospace,sans-serif;
  letter-spacing:.02em;
  text-align:center;
  max-width:260px;
  margin:0 auto;
  direction:ltr;
}

.bts-app-body {
  display:grid;
  grid-template-columns: 1fr 180px;
  min-height:340px;
}

.bts-app-side {
  background:#08131f;
  border-left:1px solid rgba(255,255,255,.05);
  border-right:0;
  padding:20px 14px;
  order: 2;
}
.bts-app-side .side-brand {
  display:flex;
  align-items:center;
  gap:8px;
  font-size:12.5px;
  font-weight:800;
  color:#fff;
  margin-bottom:22px;
  padding:0 4px;
  font-family:'Inter',sans-serif;
  direction:ltr;
}
.bts-app-side .side-brand .dot {
  width:6px; height:6px; border-radius:50%;
  background:#10b981;
  box-shadow:0 0 0 3px rgba(16,185,129,.18);
}
.bts-app-side ul {
  list-style:none;
  padding:0; margin:0;
}
.bts-app-side li {
  font-size:12px;
  color:#7a8fa8;
  padding:8px 10px;
  border-radius:6px;
  margin-bottom:2px;
  font-weight:500;
  display:flex;
  align-items:center;
  gap:8px;
}
.bts-app-side li.active {
  background:rgba(59,130,246,.12);
  color:#e8eef7;
  font-weight:600;
}
.bts-app-side li::before {
  content:"";
  width:4px; height:4px;
  border-radius:50%;
  background:currentColor;
  opacity:.5;
}
.bts-app-side li.active::before {
  background:#3b82f6;
  opacity:1;
  box-shadow:0 0 0 3px rgba(59,130,246,.15);
}

.bts-app-main {
  padding:22px 22px 24px;
  background:linear-gradient(160deg,#0a1729 0%,#0a1828 100%);
  order: 1;
}
.bts-app-head {
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:18px;
  flex-direction:row-reverse;
}
.bts-app-head h4 {
  font-size:15px;
  font-weight:800;
  color:#fff;
  margin:0 0 4px;
}
.bts-app-head p {
  font-size:11px;
  color:#7a8fa8;
  margin:0;
}
.bts-app-head .btn-mock {
  background:#3b82f6;
  color:#fff;
  font-size:11px;
  font-weight:700;
  padding:6px 12px;
  border-radius:6px;
}

.bts-app-kpis {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:18px;
}
.bts-app-kpis .k {
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.06);
  border-radius:8px;
  padding:10px 12px;
}
.bts-app-kpis .k .lbl {
  font-size:10px;
  color:#7a8fa8;
  margin-bottom:4px;
  font-weight:600;
}
.bts-app-kpis .k .val {
  font-size:16px;
  font-weight:800;
  color:#fff;
  font-family:'Inter',sans-serif;
  direction:ltr;
  unicode-bidi:isolate;
  text-align:right;
}
.bts-app-kpis .k .val.blue { color:#3b82f6; }
.bts-app-kpis .k .val.gold { color:#C9A84C; }
.bts-app-kpis .k .val.green{ color:#10b981; }

.bts-app-table {
  width:100%;
  border-collapse:collapse;
}
.bts-app-table th {
  text-align:right;
  font-size:10px;
  font-weight:700;
  color:#6a7d94;
  padding:6px 0 8px;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.bts-app-table td {
  font-size:11.5px;
  color:#b8c5d6;
  padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.04);
}
.bts-app-table tr:last-child td { border-bottom:0; }
.bts-app-table .status {
  display:inline-block;
  font-size:9.5px;
  font-weight:700;
  padding:3px 8px;
  border-radius:100px;
}
.bts-app-table .status.ok    { color:#10b981; background:rgba(16,185,129,.12); }
.bts-app-table .status.warn  { color:#f59e0b; background:rgba(245,158,11,.12); }
.bts-app-table .status.info  { color:#3b82f6; background:rgba(59,130,246,.12); }

/* ─── SECTION BASE ─────────────────────────────────────── */
.bts-section { padding:96px 0; position:relative; }
.bts-section.navy {
  background:
    radial-gradient(900px 400px at 85% -20%, rgba(59,130,246,.10), transparent 60%),
    linear-gradient(180deg,#0b1a2b 0%,#0a1729 100%);
  color:#e8eef7;
}
.bts-section.light {
  background:#f5f7fa;
  color:#1a2332;
}
[data-theme="dark"] .bts-section.light {
  background:#0e1f33;
  color:#e8eef7;
}

/* ─── SECTION HEADS ────────────────────────────────────── */
.bts-head { max-width:760px; margin-bottom:64px; }
.bts-head .rule {
  display:block; width:44px; height:2px;
  background:var(--bts-gold); margin-bottom:20px;
}
.bts-head .kicker {
  display:block;
  font-size:13px; letter-spacing:.04em;
  font-weight:700; color:var(--bts-gold); margin-bottom:14px;
}
.bts-head h2 {
  font-size:clamp(26px,3.2vw,42px);
  font-weight:800;
  line-height:1.35;
  margin:0 0 18px;
}
.bts-section.navy .bts-head h2 { color:#fff; }
.bts-section.light .bts-head h2 { color:#0b1a2b; }
[data-theme="dark"] .bts-section.light .bts-head h2 { color:#fff; }
.bts-head p {
  font-size:16.5px; line-height:1.85; margin:0;
  max-width:640px;
}
.bts-section.navy .bts-head p { color:#b8c5d6; }
.bts-section.light .bts-head p { color:#4a5666; }
[data-theme="dark"] .bts-section.light .bts-head p { color:#b8c5d6; }

/* ─── PILLARS ──────────────────────────────────────────── */
.bts-pillars {
  display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
}
.bts-pillar {
  background:#fff;
  border:1px solid #e6ebf2;
  border-radius:14px;
  padding:32px 26px;
  position:relative;
  transition:transform .25s, box-shadow .25s, border-color .25s;
}
.bts-pillar:hover {
  transform:translateY(-4px);
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-pillar {
  background:#122a44;
  border-color:rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-pillar:hover {
  border-color:#3b82f6;
  box-shadow:0 20px 40px rgba(0,0,0,.3);
}
.bts-pillar .num {
  display:inline-block;
  font-size:11.5px; font-weight:800;
  color:var(--bts-gold);
  padding:5px 10px;
  border-radius:100px;
  background:rgba(201,168,76,.08);
  border:1px solid rgba(201,168,76,.2);
  margin-bottom:20px;
}
[data-theme="dark"] .bts-pillar .num {
  background:rgba(201,168,76,.12);
  border-color:rgba(201,168,76,.25);
}
.bts-pillar h3 {
  font-size:17px; font-weight:700; margin:0 0 12px;
  color:#0b1a2b; line-height:1.5;
}
[data-theme="dark"] .bts-pillar h3 { color:#fff; }
.bts-pillar p {
  font-size:14.5px; line-height:1.8; color:#4a5666; margin:0;
}
[data-theme="dark"] .bts-pillar p { color:#b8c5d6; }

/* ─── SERVICE CARDS ────────────────────────────────────── */
.bts-services {
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
}
.bts-svc {
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  padding:32px 28px;
  transition:background .25s, border-color .25s, transform .25s;
  position:relative;
  overflow:hidden;
}
.bts-svc::after {
  content:"";
  position:absolute; right:0; top:0; bottom:0; width:2px;
  background:var(--bts-gold);
  transform:scaleY(0);
  transform-origin:top;
  transition:transform .35s ease;
}
.bts-svc:hover {
  background:rgba(59,130,246,.06);
  border-color:rgba(59,130,246,.28);
  transform:translateY(-3px);
}
.bts-svc:hover::after { transform:scaleY(1); }
.bts-svc h3 {
  font-size:17px; font-weight:700; color:#fff;
  margin:0 0 12px;
}
.bts-svc p {
  font-size:14.5px; line-height:1.8; color:#b8c5d6; margin:0;
}

/* ─── ENGAGEMENT PHASES ────────────────────────────────── */
.bts-phases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.bts-phase {
  background: #fff;
  border: 1px solid #e6ebf2;
  border-radius: 16px;
  padding: 40px 32px;
  position: relative;
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.bts-phase:hover {
  transform: translateY(-4px);
  border-color: #3b82f6;
  box-shadow: 0 24px 60px rgba(11,26,43,.08);
}
[data-theme="dark"] .bts-phase {
  background: #122a44;
  border-color: rgba(255,255,255,.08);
}
[data-theme="dark"] .bts-phase:hover {
  border-color: rgba(59,130,246,.4);
  box-shadow: 0 24px 60px rgba(0,0,0,.35);
}
.bts-phase.featured {
  border-color: #3b82f6;
  box-shadow: 0 16px 48px rgba(59,130,246,.12);
}
[data-theme="dark"] .bts-phase.featured {
  border-color: rgba(59,130,246,.5);
  box-shadow: 0 16px 48px rgba(59,130,246,.18);
}
.bts-phase-num {
  font-size: 12px;
  font-weight: 800;
  color: var(--bts-gold);
  margin-bottom: 16px;
}
.bts-phase h3 {
  font-size: 24px;
  font-weight: 800;
  color: #0b1a2b;
  margin: 0 0 16px;
}
[data-theme="dark"] .bts-phase h3 { color: #fff; }
.bts-phase-lead {
  font-size: 15px;
  line-height: 1.8;
  color: #4a5666;
  margin: 0 0 28px;
}
[data-theme="dark"] .bts-phase-lead { color: #b8c5d6; }
.bts-phase-meta {
  padding-top: 16px;
  border-top: 1px solid #e6ebf2;
  margin-bottom: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
[data-theme="dark"] .bts-phase-meta { border-color: rgba(255,255,255,.08); }
.bts-phase-label {
  font-size: 11.5px;
  font-weight: 800;
  color: #7a8699;
}
[data-theme="dark"] .bts-phase-label { color: #7a8fa8; }
.bts-phase-value {
  font-size: 14.5px;
  font-weight: 600;
  color: #0b1a2b;
  line-height: 1.6;
}
[data-theme="dark"] .bts-phase-value { color: #e8eef7; }
.bts-phases-note {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid #e6ebf2;
  font-size: 17px;
  line-height: 1.8;
  color: #4a5666;
  text-align: center;
  max-width: 720px;
  margin-inline: auto;
  font-style: italic;
}
[data-theme="dark"] .bts-phases-note {
  border-color: rgba(255,255,255,.08);
  color: #b8c5d6;
}

/* ─── PRODUCT TAG ─────────────────────────────────────── */
.bts-product-tag {
  display:inline-block;
  font-size:11px; font-weight:800;
  padding:5px 10px; border-radius:100px;
  margin-bottom:20px;
}
.bts-product-tag.dev {
  color:#FFD770;
  background:rgba(201,168,76,.1);
  border:1px solid rgba(201,168,76,.25);
}

/* ─── ACCESSIBILITY ───────────────────────────────────── */
.bts-hero-cta a:focus-visible,
.bts-hero-eyebrow:focus-visible,
.btn:focus-visible {
  outline: 2px solid #FFD770;
  outline-offset: 3px;
  border-radius: 4px;
}

/* ─── RTL refinements ─────────────────────────────────── */
body.rtl .bts-head .rule { margin-inline-start: 0; }
body.rtl .bts-hero-stats { flex-direction:row-reverse; }

/* ─── RESPONSIVE ───────────────────────────────────────── */
@media (max-width:1100px) {
  .bts-hero-grid { grid-template-columns:1fr; gap:48px; }
  .bts-pillars { grid-template-columns:1fr 1fr; }
  .bts-services { grid-template-columns:1fr 1fr; }
  .bts-phases { grid-template-columns:1fr; }
}
@media (max-width:720px) {
  .bts-section { padding:64px 0; }
  .bts-pillars, .bts-services { grid-template-columns:1fr; }
  .bts-hero { padding:64px 0 56px; }
  .bts-hero-stats { gap:22px; flex-wrap:wrap; }
  .bts-app-body { grid-template-columns: 1fr; }
  .bts-app-side {
    border-left:0;
    border-bottom:1px solid rgba(255,255,255,.05);
    padding:14px;
    order: 2;
  }
  .bts-app-main { order: 1; }
  .bts-app-side ul { display:flex; gap:8px; overflow-x:auto; }
  .bts-app-side li { white-space:nowrap; padding:6px 10px; margin:0; }
  .bts-app-side .side-brand { margin-bottom:12px; }
  .bts-phase { padding: 32px 24px; }
  .bts-app-kpis { grid-template-columns: 1fr 1fr; }
  .bts-app-kpis .k:nth-child(3) { grid-column: span 2; }
}
</style>
</head>
<body class="rtl">

<div class="utility-bar"><div class="container">
  <div><a href="../ar.html">BTS · غلاسكو، المملكة المتحدة</a></div>
  <div>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="تبديل الوضع الداكن" title="تبديل الوضع الداكن">
      <svg class="icon-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    </button>
    <a href="../blog/">رؤى</a>
    <a href="../ar.html#contact">اتصل بنا</a>
    <a href="custom-software.html" onclick="setLang('en')">English</a>
  </div>
</div></div>

<nav class="nav"><div class="container">
  <a href="../ar.html" class="brand">
    <img src="../assets/images/Logo.png" alt="BTS">
    حلول تكنولوجيا الأعمال
  </a>
  <button class="mobile-toggle" onclick="toggleMobile()" aria-label="افتح القائمة">☰</button>
  <ul class="nav-links">
