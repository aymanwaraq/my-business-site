      <ol>
        <li>BOL / Invoice / Customs</li>
        <li>AI document extraction</li>
        <li>Data validation</li>
        <li>Risk detection</li>
        <li>Approval / Escalation</li>
        <li>Logistics system</li>
      </ol>
    </div>
    <div class="usecase">
      <h3>WhatsApp operations</h3>
