<script>gtag('js',new Date());gtag('config','G-72BT0DL8NJ');</script>
<script>
(function(){
  try {
    var saved = localStorage.getItem('bts_theme');
    var pref = saved ? saved :
               (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (pref === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch(e){}
})();
</script>
<style>
/* Page-scoped additions that don't belong in the global stylesheet.
   All colours come from global CSS variables so light/dark work automatically. */

/* Vertical flow */
.flow-vertical{max-width:520px;margin:40px auto 0;display:flex;flex-direction:column;align-items:center}
.flow-node{
  background:var(--bg);color:var(--text);
  padding:14px 28px;border-radius:var(--radius);
  font-weight:600;font-size:15px;
  border:1px solid var(--line);
  width:100%;text-align:center;
}
.flow-down{color:var(--gold);font-size:22px;font-weight:700;line-height:1;padding:10px 0}

/* Pillars grid — 4 columns */
.pillars-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px}
.pillar{
  background:var(--bg);border:1px solid var(--line);
  border-radius:var(--radius-lg,8px);padding:24px;
}
.pillar .num{color:var(--gold);font-size:12px;font-weight:800;letter-spacing:.1em;margin-bottom:8px}
.pillar h4{color:var(--text);font-size:15px;font-weight:700;margin:0 0 10px}
.pillar p{color:var(--text-2);font-size:13px;margin:0;line-height:1.6}

/* Before / With comparison */
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:40px}
.compare-col{
  background:var(--bg);border:1px solid var(--line);
  border-radius:var(--radius-lg,8px);padding:32px;
}
.compare-col h3{font-size:18px;font-weight:700;margin:0 0 20px;color:var(--text)}
.compare-col.before h3{color:var(--text-2)}
.compare-col.after h3{color:var(--accent)}
.compare-col ol{margin:0;padding:0 0 0 20px;color:var(--text-2);font-size:15px;line-height:2}
.compare-col.after ol{color:var(--text)}

/* Outcomes table */
.outcomes-table{width:100%;border-collapse:collapse;margin-top:32px;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg,8px);overflow:hidden}
.outcomes-table th{background:var(--bg-2);color:var(--text);text-align:left;padding:16px 24px;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-bottom:1px solid var(--line)}
.outcomes-table td{padding:14px 24px;border-bottom:1px solid var(--line);font-size:15px;color:var(--text-2)}
.outcomes-table tr:last-child td{border-bottom:0}
.outcomes-table td:first-child{color:var(--text-3)}
.outcomes-table td:last-child{color:var(--text);font-weight:500}

/* UK + GCC advantage */
.advantage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
.advantage{
  background:var(--bg);border:1px solid var(--line);
  border-radius:var(--radius-lg,8px);padding:28px;
}
.advantage .label{font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--gold);margin-bottom:10px}
.advantage h4{font-size:16px;font-weight:700;color:var(--text);margin:0 0 10px}
.advantage p{font-size:14px;color:var(--text-2);margin:0;line-height:1.65}

/* Mobile use cases (SVG fallback) */
.mobile-usecases{display:none}

@media(max-width:900px){
  .pillars-grid{grid-template-columns:1fr 1fr}
  .advantage-grid{grid-template-columns:1fr}
  .compare-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .pillars-grid{grid-template-columns:1fr}
  .use-case-svg{display:none}
  .mobile-usecases{display:block;margin-top:8px}
  .mobile-usecases .usecase{
    background:var(--bg);border:1px solid var(--line);
    border-radius:var(--radius-lg,8px);padding:20px;margin-bottom:16px;
  }
  .mobile-usecases h3{color:var(--text);font-size:16px;margin:0 0 12px}
  .mobile-usecases ol{margin:0;padding:0 0 0 18px;color:var(--text-2);font-size:14px;line-height:1.9}
}
</style>
</head>
<body>

